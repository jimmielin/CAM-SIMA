[ccpp-table-properties]
  name     = rust_demo
  type     = scheme
  language = rust

[ccpp-arg-table]
  name  = rust_demo_init
  type  = scheme
[ trop_cloud_top_lev ]
  standard_name = vertical_layer_index_of_troposphere_cloud_physics_top
  units         = index
  type          = integer
  dimensions    = ()
  intent        = in
[ pver ]
  standard_name = vertical_layer_dimension
  units         = count
  type          = integer
  dimensions    = ()
  intent        = in
[ do_shift ]
  standard_name = flag_for_rust_demo_shift
  units         = flag
  type          = logical
  dimensions    = ()
  intent        = in
[ top_lev ]
  standard_name = vertical_layer_index_of_cloud_fraction_top
  units         = index
  type          = integer
  dimensions    = ()
  intent        = out
[ errmsg ]
  standard_name = ccpp_error_message
  units         = none
  type          = character | kind = len=512
  dimensions    = ()
  intent        = out
[ errflg ]
  standard_name = ccpp_error_code
  units         = 1
  type          = integer
  dimensions    = ()
  intent        = out

[ccpp-arg-table]
  name  = rust_demo_run
  type  = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units         = count
  type          = integer
  dimensions    = ()
  intent        = in
[ ncnst ]
  standard_name = number_of_ccpp_constituents
  units         = count
  type          = integer
  dimensions    = ()
  intent        = in
[ t ]
  standard_name = air_temperature
  units         = K
  type          = real | kind = kind_phys
  dimensions    = (horizontal_loop_extent, vertical_layer_dimension)
  intent        = in
[ heating_rate ]
  standard_name = tendency_of_dry_air_enthalpy_at_constant_pressure
  units         = J kg-1 s-1
  type          = real | kind = kind_phys
  dimensions    = (horizontal_loop_extent, vertical_layer_dimension)
  intent        = out
[ q ]
  standard_name = ccpp_constituents
  units         = none
  type          = real | kind = kind_phys
  dimensions    = (horizontal_loop_extent, vertical_layer_dimension, number_of_ccpp_constituents)
  intent        = in
[ const_props ]
  standard_name = ccpp_constituent_properties
  units         = none
  type          = ccpp_constituent_prop_ptr_t
  dimensions    = (number_of_ccpp_constituents)
  intent        = in
[ log_unit ]
  standard_name = log_output_unit
  units         = 1
  type          = integer
  dimensions    = ()
  intent        = in
[ masterproc ]
  standard_name = flag_for_mpi_root
  units         = flag
  type          = logical
  dimensions    = ()
  intent        = in
[ errmsg ]
  standard_name = ccpp_error_message
  units         = none
  type          = character | kind = len=512
  dimensions    = ()
  intent        = out
[ errflg ]
  standard_name = ccpp_error_code
  units         = 1
  type          = integer
  dimensions    = ()
  intent        = out
