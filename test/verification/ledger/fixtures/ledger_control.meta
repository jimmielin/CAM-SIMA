# capgen-v1-only control table (staged for v1 builds only; v0 uses the
# type=host table in ledger_host.meta instead).  v1 requires the control
# variables -- framework-injected entry-point arguments with no backing
# Fortran module -- to live in a type=control table; this mirrors
# CAM-SIMA's src/data/ccpp_control_vars.meta on the capgen-v1 branch.
[ccpp-table-properties]
  name = ledger_control
  type = control

[ccpp-arg-table]
  name = ledger_control
  type = control
[ suite_name ]
  standard_name = suite_name
  long_name = name of the CCPP suite to dispatch to
  units = none
  dimensions = ()
  type = character
  kind = len=256
[ group_name ]
  standard_name = group_name
  long_name = name of the CCPP group to dispatch to
  units = none
  dimensions = ()
  type = character
  kind = len=256
[ thread_num ]
  standard_name = thread_number
  long_name = current thread number
  units = index
  dimensions = ()
  type = integer
[ nthreads ]
  standard_name = number_of_threads
  long_name = total number of OpenMP threads
  units = count
  dimensions = ()
  type = integer
[ nphys_threads ]
  standard_name = number_of_physics_threads
  long_name = physics-internal thread budget (1 if unused)
  units = 1
  dimensions = ()
  type = integer
[ col_start ]
  standard_name = horizontal_loop_begin
  long_name = start of horizontal range for this phase
  units = index
  dimensions = ()
  type = integer
[ col_end ]
  standard_name = horizontal_loop_end
  long_name = end of horizontal range for this phase
  units = index
  dimensions = ()
  type = integer
[ errmsg ]
  standard_name = ccpp_error_message
  long_name = error message for CCPP error handling
  units = none
  dimensions = ()
  type = character
  kind = len=512
[ errcode ]
  standard_name = ccpp_error_code
  long_name = error flag for CCPP error handling
  units = 1
  dimensions = ()
  type = integer
