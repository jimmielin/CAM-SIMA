[ccpp-table-properties]
  name = ldg_order_c
  type = scheme
  dependencies = ledger_events.F90

[ccpp-arg-table]
  name = ldg_order_c_run
  type = scheme
[ nstep ]
  standard_name = ledger_current_timestep
  units = count
  dimensions = ()
  type = integer
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  dimensions = ()
  type = character
  kind = len=512
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  dimensions = ()
  type = integer
  intent = out
