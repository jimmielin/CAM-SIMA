[ccpp-table-properties]
  name = marks_consumer
  type = scheme
[ccpp-arg-table]
  name = marks_consumer_run
  type = scheme
[ nbox ]
  standard_name = horizontal_loop_extent
  type = integer
  units = count
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  type = integer
  units = count
  dimensions = ()
  intent = in
[ theta ]
  standard_name = mark_theta
  units = K
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  type = real | kind = kind_phys
  intent = inout
[ slp ]
  standard_name = mark_slp
  units = Pa
  dimensions = (horizontal_loop_extent)
  type = real | kind = kind_phys
  intent = in
[ prot ]
  standard_name = mark_prot
  units = kg m-3
  dimensions = (horizontal_loop_extent)
  type = real | kind = kind_phys
  intent = in
[ init_only ]
  standard_name = mark_init_only
  units = K
  dimensions = (horizontal_loop_extent)
  type = real | kind = kind_phys
  intent = in
[ setout ]
  standard_name = mark_setout
  units = Pa
  dimensions = (horizontal_loop_extent)
  type = real | kind = kind_phys
  intent = in
[ badpath_init ]
  standard_name = mark_badpath_init
  units = K
  dimensions = (vertical_layer_dimension)
  type = real | kind = kind_phys
  intent = in
[ badpath_noinit ]
  standard_name = mark_badpath_noinit
  units = K
  dimensions = (vertical_layer_dimension)
  type = real | kind = kind_phys
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  dimensions = ()
  type = character
  kind = len=512
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  dimensions = ()
  type = integer
  intent = out
