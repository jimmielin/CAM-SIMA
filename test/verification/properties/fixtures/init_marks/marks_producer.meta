[ccpp-table-properties]
  name = marks_producer
  type = scheme
[ccpp-arg-table]
  name = marks_producer_run
  type = scheme
[ nbox ]
  standard_name = horizontal_loop_extent
  type = integer
  units = count
  dimensions = ()
  intent = in
[ setout ]
  standard_name = mark_setout
  units = Pa
  dimensions = (horizontal_loop_extent)
  type = real | kind = kind_phys
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  dimensions = ()
  type = character
  kind = len=512
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  dimensions = ()
  type = integer
  intent = out
