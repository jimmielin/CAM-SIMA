! ---------------------------------------------------------------------------
! chem_proc gas-phase chemistry gate, T1S1 (suite mam_gas_phase_chemistry,
! chem_mechanism trop_strat_mam5_t1s1: 230 species, 542 reactions, MAM5 with
! the prognostic stratospheric sulfate). FPHYStest from the CAM cam6_4_213
! FCHIST capture bracketing chem_timestep_tend (gas_wetdep_method OFF,
! lght_no_prd_factor 0, ZEN_ANGLE added), ne3pg3 L32, start 1979-01-01 00:00,
! dtime 1800. Every file and value below mirrors that run's atm_in /
! drv_flds_in. Frame k of the tapes is CAM nstep k; SIMA reads frame
! get_nstep(), so with the same start date the calendar lines up for
! nstep >= 1. The test runs four steps: after the last step the null dycore
! reads the frame of the step that follows, so a five-step run on a
! five-frame tape stops with an end-of-tape read after the last check.
! ---------------------------------------------------------------------------
ncdata       = '/glade/campaign/cesm/community/amwg/sima_baselines/cam_sima_test_snapshots/cam6_4_213_ne3pg3_fchist_trop_strat_mam5_t1s1_chem_timestep_tend_snapshot_derecho_gnu_before_c20261021.nc'
ncdata_check = '/glade/campaign/cesm/community/amwg/sima_baselines/cam_sima_test_snapshots/cam6_4_213_ne3pg3_fchist_trop_strat_mam5_t1s1_chem_timestep_tend_snapshot_derecho_gnu_after_c20261021.nc'

! FCHIST (cam6) vertical grid
pver = 32

! Tolerance. The check reports a relative difference for values at or above
! min_relative_value (its default, 1e-5) and an absolute one below it, so
! the number tracers (kg-1), CO2 and stratospheric O3 are compared relative
! and the other mass mixing ratios absolute. 1e-14 clears the ulp-class
! floors (the mam_vmr pack round trip, the solver tolerance cascade) and
! the zenith floor of the null dycore's lat/lon degree round trip, which
! perturbs 21 of 273 daylight columns' photolysis rates by 1e-14 to 1e-12
! and leaves O3 at 4e-15 relative.
ncdata_check_err = .true.
min_difference = 1.0e-14

! Rows excluded with their documented floors (gate run 16 of 2026-10-21,
! maxima over the four steps; relative for values at or above 1e-5,
! absolute below, so num_c5 is absolute).
! All of them trace to the altitude-based external forcing files (aircraft
! bc_a4/num_a4/NO2/SO2, anthro-ene num_a1/so4_a1, volcano SO2/num/so4): CAM
! interpolates them at timestep init with the dycore interface heights,
! which the tape does not carry, so SIMA's forcing differs in about 2900
! aircraft cells (up to a full cell at the layer edges) and 360 volcano
! cells, and the aerosol cluster and the solver carry that forward. A
! capture with ext_frc_specifier empty on both sides drops every one of
! these rows into the ulp class.
!  - num_a4 0.11 (an aircraft forcing cell), num_a1 3.2e-3, num_a2 1.3e-4,
!    num_a5 1e-5, num_c2 9.1e-6, num_c1 1.9e-6, num_c5 1.3e-12
!  - so4_a1 5e-13, soa5_a1 and soag4 6.4e-14 (the anthro-ene cell)
!  - co2 1.8e-12 (CO + OH in the forcing-perturbed columns)
!  - water vapor 4e-12 relative in about 1100 cells (H2O is a solution
!    species of T1S1, produced by CH4 oxidation in the forcing-perturbed
!    columns; 1e-23 without the forcing). The row carries the standard name
!    because water vapor is the host's constituent, not a chemistry one.
! Every thermal and user rate constant, every stratospheric heterogeneous
! rate and every solver production and loss term is bitwise; the NH3 to NH4
! bookkeeping and the setsox tendency baseline of the aerosol cluster match
! CAM (runs 13 and 16 of the gate).
ncdata_check_exclude = 'num_a4', 'num_a1', 'num_a2', 'num_a5', 'num_c1', 'num_c2',
         'num_c5', 'so4_a1', 'soa5_a1', 'soag4', 'co2',
         'water_vapor_mixing_ratio_wrt_moist_air_and_condensed_water'

! mechanism selection (both packages are in the suite)
chem_mechanism = 'trop_strat_mam5_t1s1'

! no prescribed oxidants: O3, OH, NO3 and HO2 are solution species of T1S1
