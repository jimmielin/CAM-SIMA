! newnuc+coag sit mid-cluster inside CAM's aero_model_gasaerexch, so this test
! starts from an interior boundary of the unified multi-step snapshot. ONE file
! serves as both ncdata and ncdata_check because it carries all the bracket
! captures; fields are read and checked every step at the matching frame.
!
! the unified snapshot captures the following sequence
!   (upstream setsox/imp_sol)
!   ------ P_start ------ (aerochem_vmr_* before tape)
!   gasaerexch
!   rename
!   apply tendencies from gasaerexch+rename on vmr
!   ------ P_end ------- (aerochem_vmr_* after tape)
!   newnuc
!   ------ P2 ------ (aerochem_vmr_postnewnuc_* after tape)
!   coag
!   ------ P3 ------ (aerochem_vmr_postcoag_* after tape)
!   (downstream NH3 conservation)
!
! So in order to test newnuc+coag here, we use a unified "after" snapshot as ncdata and ncdata_check
! here (because it contains the aerochem_vmr_* at the start from the "after" tape
!       and postnewnuc and postcoag fields for VMR):
!  - input (ncdata):
!    initialize vmr from the aerochem_vmr_* as the starting state (P_end)
!    the remaining inputs for newnuc (mam_del_h2so4_*, zm, pblh, cld, Q) come from the same file.
!  - run:
!    (1) newnuc applies its tendency to the working vmr (checkpointed into mam_vmr_postnewnuc),
!    ncdata_check will compare it against postnewnuc as a constituent-dimensioned field read.
!
!    (2) then, coag mutates the vmr in place (checkpointed into mam_vmr_postcoag),
!    same: ncdata_check will compare it against postcoag.
!  - results (ncdata_check): mam_vmr_postnewnuc vs aerochem_vmr_postnewnuc_*
!    isolates the newnuc port; mam_vmr_postcoag vs aerochem_vmr_postcoag_*
!    proves the newnuc->coag chaining.
!
! The plain aerochem_vmr_* rows are the newnuc-ENTRY capture, but at check time
! the working vmr they initialized already got changed into the post-coag state -> expected
! structural noise by design, so they should not be compared.
! Please see the suite_mam_newnuc_coag.xml header (atmospheric_physics) for the scheme-level detail.

ncdata = '/glade/campaign/cesm/community/amwg/sima_baselines/cam_sima_test_snapshots/cam6_4_185_ne3pg3_fhist_modal_aero_gasaerexch-block-multi-snapshot_derecho_gnu_unified_after_c20260709.nc'
ncdata_check = '/glade/campaign/cesm/community/amwg/sima_baselines/cam_sima_test_snapshots/cam6_4_185_ne3pg3_fhist_modal_aero_gasaerexch-block-multi-snapshot_derecho_gnu_unified_after_c20260709.nc'

! the aerochem_vmr_ plain fields are from gasaerexch (full pipeline) above
! but the _c_ cloud-borne can be kept for consistency check against the input:
! (this is the minimal exclusion set for a ncdata_check_err = .true.)
ncdata_check_exclude = '!aerochem_vmr_post*', '!aerochem_vmr_*_c*', 'aerochem_vmr_*'
ncdata_check_err = .true.
min_difference = 2e-15

